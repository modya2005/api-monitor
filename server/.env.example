NODE_ENV=production
PORT=4000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/api-monitor
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_DAYS=7
CRON_SECRET=replace-with-another-long-random-secret
ALLOW_PRIVATE_HOSTS=false
ENABLE_DEMO_ENDPOINTS=false
RETENTION_DAYS=30

# Optional email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
DEFAULT_ALERT_EMAIL=
